# ЭКОТЕХ — настройки Apache для хостинга Джино
AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Служебный журнал автодеплоя не отдаём наружу
  RewriteRule (^|/)\.ftp-deploy-sync-state\.json$ - [F,L]

  # HTTP → HTTPS (включено 27.09.2026; сертификат выпущен в cp.jino.ru).
  # На Джино протокол приходит в заголовке X-Forwarded-Protocol (справка Джино, SSL).
  # Условие «=http», а не «!=https»: если заголовка нет, перенаправления нет — цикл исключён.
  RewriteCond %{HTTP:X-Forwarded-Protocol} =http
  RewriteRule ^ https://ecotechnew.ru%{REQUEST_URI} [R=301,L]

  # www → без www
  RewriteCond %{HTTP_HOST} ^www\.ecotechnew\.ru$ [NC]
  RewriteRule ^ https://ecotechnew.ru%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/plain application/ld+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf X-Forwarded-Protocol "^(.*)$" XFP=$1
</IfModule>

<IfModule mod_headers.c>
  # Диагностика перенаправления на HTTPS: какой протокол сообщил Джино
  Header always set X-Ecotech-Proto "%{XFP}e"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'"
</IfModule>
